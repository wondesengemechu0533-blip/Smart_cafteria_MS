                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/kitchen/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["kitchen", "dashboard"]
