{
  "info": {
    "_postman_id": "kitchen-staff-api-v1",
    "name": "🍳 Kitchen Staff API",
    "description": "Complete Kitchen Staff Management System API Collection\n\nIncludes:\n- Authentication\n- Order Management\n- Food Availability\n- Stock Alerts\n- Shift Management\n- Analytics & Reports",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "25831557"
  },
  "item": [
    {
      "name": "🔐 Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    pm.environment.set('token', jsonData.token);",
                  "    pm.environment.set('userId', jsonData.user.id);",
                  "    pm.environment.set('userName', jsonData.user.name);",
                  "    console.log('✅ Token saved:', jsonData.token.substring(0, 20) + '...');",
                  "}",
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kitchen@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "📊 Dashboard & Orders",
      "item": [
        {
          "name": "Get Kitchen Dashboard",
          "request": {
            "method": "GET",
